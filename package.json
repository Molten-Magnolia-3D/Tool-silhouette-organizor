{
  "name": "pocketplate",
  "productName": "Pocketplate",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop studio that traces tool silhouettes and exports 3D-printable pocket plates.",
  "author": "Molten Magnolia 3D",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run build:electron && electron-builder --publish never",
    "build:win": "tsc -p tsconfig.json --noEmit && vite build && npm run build:electron && electron-builder --win --x64 --publish never",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.moltenmagnolia.pocketplate",
    "productName": "Pocketplate",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Molten-Magnolia-3D",
      "repo": "Tool-silhouette-organizor"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pocketplate",
      "uninstallDisplayName": "Pocketplate",
      "artifactName": "Pocketplate-Setup-${version}.${ext}"
    }
  }
}
